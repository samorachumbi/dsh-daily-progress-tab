{
  "name": "dsh-daily-progress-tab",
  "version": "0.1.0",
  "description": "DSH daily progress planner in its own browser tab, plus agent tools: today's checklist, tomorrow's plan, week heatmap, streak, and per-task suggestion chips the model can author.",
  "keywords": ["dsh", "deepseek-harness", "plugin", "planner", "tasks", "productivity", "agent-tools", "portfolio"],
  "repository": { "type": "git", "url": "git+https://github.com/samorachumbi/dsh-daily-progress-tab.git" },
  "homepage": "https://github.com/samorachumbi/dsh-daily-progress-tab#readme",
  "author": "Samora Chumbi",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "probe": "node scripts/probe.mjs",
    "render": "node scripts/render-ui.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "22.20.0",
    "typescript": "6.0.3"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
